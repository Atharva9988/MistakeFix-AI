{
    "version": 2,
    "builds": [
        {
            "src": "public/**",
            "use": "@vercel/static"
        },
        {
            "src": "api/diagnose.py",
            "use": "@vercel/python"
        }
    ],
    "routes": [
        {
            "src": "/api/diagnose",
            "dest": "api/diagnose.py"
        },
        {
            "src": "/(.*)",
            "dest": "public/$1"
        }
    ]
}